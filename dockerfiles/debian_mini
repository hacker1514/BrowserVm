FROM --platform=linux/386 docker.io/i386/debian:buster
ARG DEBIAN_FRONTEND=noninteractive

# Point APT to the archived mirrors (Buster is EOL)
RUN echo "deb [trusted=yes] http://archive.debian.org/debian buster main contrib non-free" \
  > /etc/apt/sources.list && \
	echo "deb [trusted=yes] http://archive.debian.org/debian-security buster/updates main" \
	>> /etc/apt/sources.list

RUN apt-get clean && apt-get update && apt-get -y upgrade
RUN apt-get -y install apt-utils gcc gcc-8 cpp-8 g++ build-essential libc6-dev \
	python3 vim unzip ruby nodejs \
	fakeroot dbus base-files whiptail hexedit \
	patch wamerican ucf manpages \
	file luajit make lua5.3 dialog curl \
	less cowsay netcat-openbsd
RUN userdel -r user 2>/dev/null || true; groupadd -g 1000 Hacker 2>/dev/null || true; useradd -u 1000 -g 1000 -m -s /bin/bash Hacker 2>/dev/null || true; echo "Hacker:1234" | chpasswd
COPY --chown=Hacker:Hacker ./examples /home/Hacker/examples
COPY --chown=Hacker:Hacker ./documents /home/Hacker/documents
RUN chmod -R +x  /home/Hacker/examples/lua 2>/dev/null || true
# We set WORKDIR, as this gets extracted by Webvm to be used as the cwd. This is optional.
WORKDIR /home/Hacker/
# We set env, as this gets extracted by Webvm. This is optional.
ENV HOME="/home/Hacker" TERM="xterm-256color" USER="Hacker" LOGNAME="Hacker" SHELL="/bin/bash" EDITOR="vim" LANG="C.UTF-8"
RUN echo 'root:1234' | chpasswd
RUN sed -i 's/mesg n.*/# mesg n/g' /etc/profile /root/.profile 2>/dev/null || true
RUN echo "export LS_COLORS='ow=01;34:tw=01;34:st=01;34:di=01;34'" >> /etc/bash.bashrc
RUN echo 'set_my_prompt() { export PS1="\[\033[1;34m\][[ \[\033[1;33m\]K \[\033[1;37m\]: \[\033[1;32m\]\w \[\033[1;34m\]]] \[\033[1;37m\]: \[\033[1;35m\]\$ \[\033[1;36m\]"; trap "printf \"\033[1;37m\"" DEBUG; }' >> /etc/bash.bashrc && echo 'PROMPT_COMMAND=set_my_prompt' >> /etc/bash.bashrc
CMD [ "/bin/bash" ]
